# Input rail: classify off-topic requests and answer with a short scope message.
define flow kavach scope check
  $on_topic = execute check_scope(text=$user_message)
  if not $on_topic
    bot refuse off topic
    stop

define bot refuse off topic
  "I can only help with scams and staying safe. Forward me a message you're unsure about, or text help."

# Output rails. The service marks practice texts with a "[practice]" user turn, which adds the
# practice rails: no real links and never asking for anything real.
define flow kavach output safety
  if $user_message == "[practice]"
    $practice_ok = execute check_practice_output(text=$bot_message)
    if not $practice_ok
      bot refuse unsafe practice
      stop
  $ok = execute check_output_safety(text=$bot_message)
  if not $ok
    bot refuse unsafe output
    stop

define bot refuse unsafe output
  "I can't send that. Never share codes, PINs, passwords or payment details with anyone."

define bot refuse unsafe practice
  "Practice text blocked: it must not contain links or ask for anything real."
