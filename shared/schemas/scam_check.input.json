{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "person_id": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "maxLength": 8000
    },
    "sender_e164": {
      "type": "string",
      "pattern": "^(\\+[1-9]\\d{6,14})?$"
    },
    "source": {
      "enum": [
        "imessage",
        "share",
        "app_paste",
        "screenshot",
        "call"
      ]
    },
    "reply_to_e164": {
      "type": "string",
      "pattern": "^(\\+[1-9]\\d{6,14})?$"
    },
    "reply_channel": {
      "enum": [
        "",
        "imessage",
        "sms",
        "rcs",
        "whatsapp"
      ]
    },
    "image_base64": {
      "type": "string"
    }
  },
  "required": [
    "person_id"
  ],
  "additionalProperties": true,
  "title": "POST /run/scam_check"
}
